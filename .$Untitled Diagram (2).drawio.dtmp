roundColor=#ffffff;verticalAlign=top;strokeWidth=2;strokeColor=#0080F0;shadow=0;dashed=0;shape=mxgraph.ios7.icons.mail;" value="Notify by SNS Email" vertex="1"><mxGeometry height="30" width="52.8" x="2180" y="1174.3" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-4" edge="1" parent="1" source="uv1_tUdL1AAHlAUDnkOu-104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" target="XS6ARsYb1etzcZC_o9MQ-1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-6" edge="1" parent="1" source="uv1_tUdL1AAHlAUDnkOu-104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.003;entryY=0.437;entryDx=0;entryDy=0;entryPerimeter=0;" target="XS6ARsYb1etzcZC_o9MQ-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-7" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" value="Cloud watch&lt;div&gt;(Report on response)&lt;/div&gt;" vertex="1"><mxGeometry height="60" width="60" x="2180" y="1060" as="geometry"/></mxCell><mxCell id="e84VPStO0c2QMAOF5gBt-2" edge="1" parent="1" source="XS6ARsYb1etzcZC_o9MQ-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="uv1_tUdL1AAHlAUDnkOu-83" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-8" parent="1" style="shape=rect;fillColor=#EE5396;aspect=fixed;resizable=0;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeColor=none;fontSize=14;" value="Ansible runner VM" vertex="1"><mxGeometry height="48" width="48" x="972.6299999999999" y="1041" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-9" parent="XS6ARsYb1etzcZC_o9MQ-8" style="fillColor=#ffffff;strokeColor=none;dashed=0;outlineConnect=0;html=1;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;part=1;movable=0;resizable=0;rotatable=0;shape=mxgraph.ibm_cloud.logo--ansible-community" value="" vertex="1"><mxGeometry height="24" relative="1" width="24" as="geometry"><mxPoint x="12" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-12" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" value="" vertex="1"><mxGeometry height="60" width="60" x="875.45" y="358" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-14" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Monitoring in dept&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;&quot;&gt;-&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&amp;nbsp;The server and workstations's logs are collected by the Alloy agent running on them. And it sends them to the Collector.&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;&quot;&gt;- The collector forwards everything through the router and send it to Loki through the VPN&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- A Grafana alert rule over Loki counts failed logins per IP. When alert is present Grafana publishes it to SNS.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- SNS copies the alert into SQS.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- SQS waits for Lambda. Lambda matches the alert against rules and runs actions:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- CloudWatch is used as a data source that holds the health numbers&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- Notify by SNS email&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- Record incident in DynamoDB&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- Block attacker&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1"><mxGeometry height="430" width="300" x="462.2" y="1020" as="geometry"/></mxCell><mxCell id="XS6ARsYb1etzcZC_o9MQ-16" parent="1" style="points=[];aspect=fixed;html=1;align=center;shadow=0;dashed=0;fillColor=#FF6A00;strokeColor=none;shape=mxgraph.alibaba_cloud.dns_privatezone_01;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;DNS Private Zone&lt;/div&gt;" vertex="1"><mxGeometry height="52.8" width="53.67" x="510" y="347.20000000000005" as="geometry"/></mxCell><mxCell id="peH1CwfToylsjEGwY1Sm-2" edge="1" parent="1" source="peH1CwfToylsjEGwY1Sm-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="uv1_tUdL1AAHlAUDnkOu-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="peH1CwfToylsjEGwY1Sm-3" edge="1" parent="1" source="peH1CwfToylsjEGwY1Sm-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;