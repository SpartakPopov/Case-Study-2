e=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="mPxtxcqtT4NIdoU_DzGL-456"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="PQKRVMBuUAo1p1vsrlH6-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" value="" vertex="1"><mxGeometry height="105" width="160" x="1021.0999999999999" y="110" as="geometry"/></mxCell><mxCell id="PQKRVMBuUAo1p1vsrlH6-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;Internal VPC&lt;/font&gt;" vertex="1"><mxGeometry height="30" width="138.9" x="861.1" y="80" as="geometry"/></mxCell><mxCell id="PQKRVMBuUAo1p1vsrlH6-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;DMZ (VPC)&lt;/font&gt;" vertex="1"><mxGeometry height="30" width="138.9" x="-270" y="320" as="geometry"/></mxCell><mxCell id="PQKRVMBuUAo1p1vsrlH6-51" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" value="" vertex="1"><mxGeometry height="110" width="120" x="-30" y="208.5" as="geometry"/></mxCell><mxCell id="uv1_tUdL1AAHlAUDnkOu-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;On-prem&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;&quot;&gt;-&lt;/font&gt;&lt;font style=&quot;&quot;&gt; PFsense router for firewall, VPN, DNS&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Switches seperate departemnts through subnets&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Linux VM for collecting logs&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Linux Server acts as a file server&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;- Work stations and linux server run Alloy agents to send the logs to the collector.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1"><mxGeometry height="270" width="280" x="-38.5" y="675" as="geometry"/></mxCell><mxCell id="peH1CwfToylsjEGwY1Sm-8" edge="1" parent="1" source="uv1_tUdL1AAHlAUDnkOu-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;" target="peH1CwfToylsjEGwY1Sm-1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="uv1_tUdL1AAHlAUDnkOu-2" parent="1" style="image;html=1;image=img/lib/clip_art/networking/Wireless_Router_128x128.png" value="" vertex="1"><mxGeometry height="61.9" width="61.9" x="410.5" y="670" as="geometry"/></mxCell><mxCell id="uv1_tUdL1AAHlAUDnkOu-6" parent="1" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#505050;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.devices.workstation;" value="" vertex="1"><mxGeometry height="56" width="53" x="274" y="905" as="geometry"/></mxCell><mxCell id="uv1_tUdL1AAHlAUDnkOu-7" parent="1" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#505050;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.devices.workstation;" value="" vertex="1"><mxGeometry height="56" width="53" x="340" y="905" as="geometry"/></mxCell><mxCell id="uv1_tUdL1AAHlAUDnkOu-18" edge="1" parent="1" source="uv1_tUdL1AAHlAUDnkOu-2" style="endArrow=classic;startArrow=classic;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="e84VPStO0c2QMAOF5gBt-1" value=""><mxGeometry height="50" relative="1" width="50" as="geometry"><mxPoint x="580" y="450" as="sourcePoint"/><mxPoint x